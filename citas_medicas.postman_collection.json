              "pm.test(\"Retorna mensaje Cita médica no encontrada\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql(\"Cita médica no encontrada\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/citas/00000000-0000-0000-0000-000000000000",
