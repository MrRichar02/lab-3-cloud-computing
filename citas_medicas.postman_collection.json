    {
      "name": "6. Actualizar Cita Médica (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Retorna los datos actualizados y estado CONFIRMADA\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get(\"citaId\"));",
              "    pm.expect(jsonData.estado).to.eql(\"CONFIRMADA\");",
              "    pm.expect(jsonData.fecha).to.eql(\"2026-10-15T11:00:00Z\");",
              "    pm.expect(jsonData.motivo).to.eql(\"Revisión confirmada con electro\");",
              "    pm.expect(jsonData).to.have.property(\"actualizadoEn\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paciente\": \"Carlos Ramírez\",\n  \"medico\": \"Dra. María Gómez\",\n  \"especialidad\": \"Cardiología\",\n  \"fecha\": \"2026-10-15T11:00:00Z\",\n  \"estado\": \"CONFIRMADA\",\n  \"motivo\": \"Revisión confirmada con electro\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/citas/{{citaId}}",
          "host": [
